{
  "name": "tellbill-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "set NODE_ENV=development && tsx server/index.ts",
    "build": "esbuild server/index.ts --bundle --platform=node --target=node22 --outfile=server_dist/index.js --external:pg --external:better-sqlite3 --format=esm --packages=external",
    "start": "node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "db:reset": "set NODE_ENV=development && tsx scripts/reset-db.ts",
    "db:backup": "tsx scripts/db-backup.ts backup",
    "db:backup:weekly": "tsx scripts/db-backup.ts backup:weekly",
    "db:backup:monthly": "tsx scripts/db-backup.ts backup:monthly",
    "db:restore": "tsx scripts/db-backup.ts restore",
    "db:backups": "tsx scripts/db-backup.ts backups",
    "db:verify": "tsx scripts/db-backup.ts verify",
    "db:backup:cleanup": "tsx scripts/db-backup.ts cleanup",
    "db:backup:stats": "tsx scripts/db-backup.ts stats",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,json}\"",
    "format": "prettier --write \"**/*.{js,ts,json}\"",
    "docker:build": "docker build -t tellbill:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f server",
    "docker:db-push": "docker-compose exec server npm run db:push",
    "docker:restart": "docker-compose restart",
    "load-test:money-alerts": "tsx scripts/load-test-money-alerts.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.37.0",
    "@sentry/profiling-node": "^10.37.0",
    "@supabase/supabase-js": "^2.97.0",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "express": "^5.0.1",
    "form-data": "^4.0.5",
    "google-auth-library": "^9.14.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "twilio": "^5.12.0",
    "undici": "^7.18.2",
    "uuid": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.21.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "TellBill backend API server",
  "main": "server/index.ts"
}
