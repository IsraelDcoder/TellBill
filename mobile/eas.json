{
  "cli": {
    "version": ">= 10.0.0",
    "requireCommit": true,
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PkotlinVersion=2.0.20"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "20.19.4",
      "env": {
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -PkotlinVersion=2.0.20"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  }
}
